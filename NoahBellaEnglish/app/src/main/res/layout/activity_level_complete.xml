<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_complete"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/screen_min_height"
        android:padding="24dp">

        <!-- Celebration emojis -->
        <TextView
            android:id="@+id/tvCelebration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎉 🎊 🎉 🎊 🎉"
            android:textSize="32sp"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Level Emoji -->
        <TextView
            android:id="@+id/tvLevelEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔤"
            android:textSize="72sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/tvCelebration"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Result Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#FFFFFFFF"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@+id/tvLevelEmoji"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvLevelName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alphabet Complete!"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif-rounded"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvStars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐⭐⭐"
                    android:textSize="52sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 / 10 Correct"
                    android:textSize="20sp"
                    android:textColor="#555577"
                    android:fontFamily="sans-serif-rounded"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏆 Perfect! Noah &amp; Bella are proud of you!"
                    android:textSize="16sp"
                    android:textColor="#334455"
                    android:fontFamily="sans-serif-rounded"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Characters saying things -->
        <LinearLayout
            android:id="@+id/charRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/cardResult"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐱"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/tvNoahSays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Noah: \"Amazing!\""
                    android:textSize="12sp"
                    android:textColor="#AADDFF"
                    android:fontFamily="sans-serif-rounded"
                    android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🐱"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/tvBellaSays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bella: \"Yay! 🎀\""
                    android:textSize="12sp"
                    android:textColor="#FFAAD4"
                    android:fontFamily="sans-serif-rounded"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/btnRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/charRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btnPlayAgain"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="🔄 Play Again"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-rounded"
                android:background="@drawable/bg_button_secondary" />

            <Button
                android:id="@+id/btnLevels"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="🗺️ Levels"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-rounded"
                android:background="@drawable/bg_button_secondary" />
        </LinearLayout>

        <Button
            android:id="@+id/btnHome"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="🏠 Home"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-rounded"
            android:background="@drawable/bg_button_play"
            app:layout_constraintTop_toBottomOf="@+id/btnRow1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
