<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌟 English Adventure!"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:fontFamily="sans-serif-rounded"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Stars collected -->
    <TextView
        android:id="@+id/tvTotalStars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⭐ 0 / 18 Stars Collected"
        android:textSize="16sp"
        android:textColor="#FFE0A0"
        android:fontFamily="sans-serif-rounded"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Noah Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardNoah"
        android:layout_width="150dp"
        android:layout_height="200dp"
        android:layout_marginStart="20dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="#5B4AE8"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTotalStars"
        app:layout_constraintBottom_toTopOf="@+id/btnPlay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintEnd_toStartOf="@+id/cardBella">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐱"
                android:textSize="64sp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👔 NOAH"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#AADDFF"
                android:fontFamily="sans-serif-rounded"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\"Let's learn!\""
                android:textSize="12sp"
                android:textColor="#CCDDFF"
                android:fontFamily="sans-serif-rounded"
                android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Bella Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBella"
        android:layout_width="150dp"
        android:layout_height="200dp"
        android:layout_marginEnd="20dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="#C2185B"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTotalStars"
        app:layout_constraintBottom_toTopOf="@+id/btnPlay"
        app:layout_constraintStart_toEndOf="@+id/cardNoah"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐱"
                android:textSize="64sp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎀 BELLA"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFAAD4"
                android:fontFamily="sans-serif-rounded"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="\"You can do it!\""
                android:textSize="12sp"
                android:textColor="#FFCCEE"
                android:fontFamily="sans-serif-rounded"
                android:gravity="center"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Play Button -->
    <Button
        android:id="@+id/btnPlay"
        android:layout_width="260dp"
        android:layout_height="60dp"
        android:text="🎮  PLAY NOW!"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:fontFamily="sans-serif-rounded"
        android:background="@drawable/bg_button_play"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
